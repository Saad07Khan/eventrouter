# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# SQLAlchemy async connection string.
# Local Postgres:  postgresql+asyncpg://user:pass@localhost:5432/eventrouter
# Neon (cloud):    postgresql+asyncpg://USER:PASS@HOST/DB
#
# Two changes are needed versus the string Neon hands you:
#   1. the scheme must be postgresql+asyncpg:// (not plain postgresql://)
#   2. drop any ?sslmode=...&channel_binding=... — asyncpg rejects those
#      libpq-style params; SSL is set via DATABASE_SSL below instead.
DATABASE_URL=postgresql+asyncpg://localhost/eventrouter

# true for cloud Postgres (Neon, RDS); false for a local Postgres with no TLS.
DATABASE_SSL=true
