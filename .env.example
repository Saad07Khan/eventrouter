# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# SQLAlchemy async connection string.
# Local Postgres:  postgresql+asyncpg://user:pass@localhost:5432/event_pipeline
# Neon (cloud):    postgresql+asyncpg://USER:PASS@HOST/DB   (drop any ?sslmode=... query)
DATABASE_URL=postgresql+asyncpg://localhost/event_pipeline
